# Waitlist emails are sent via Brevo (https://brevo.com). Copy this file to
# .env.local and fill in your values. .env.local is gitignored.

# Required to actually send email. Brevo dashboard → SMTP & API → API Keys.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx

# The "From" address. With Brevo you can verify just this single sender
# (Senders, Domains & Dedicated IPs → Senders → add → enter the 6-digit code
# emailed to it). No DNS/domain verification needed to start sending.
# For best deliverability to Gmail/Yahoo, authenticate the domain in Brevo later.
WAITLIST_FROM_EMAIL=********@gmail.com
WAITLIST_FROM_NAME=Coria

# Where new-signup notifications are sent.
WAITLIST_NOTIFY_EMAIL=********@gmail.com

# Your deployed site origin, used to show the logo image in emails (email
# clients can't render inline SVG, so they load <site>/logo.png). If unset,
# emails fall back to a plain "Coria" text wordmark.
# NEXT_PUBLIC_SITE_URL=https://coria.com

# Optional: add each signup to a specific Brevo contact list (Brevo → Contacts →
# Lists → the list's numeric ID). If unset, contacts go to your general audience.
# BREVO_LIST_ID=2
